; Godot 4 starter project for an arcade vehicle-soccer game.
config_version=5

[application]
config/name="Vehicle Soccer Prototype"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]
3d/default_gravity=22.0

[input]
accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
boost={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":_SHIFT)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
toggle_ball_cam={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
air_pitch_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
air_pitch_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
air_roll_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
air_roll_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
